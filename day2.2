// write a program to calculate the area and circumference of a circle given its radius.
#include<stdio.h>
int main()
{
      int r;
	  float pi;
	  float area, circumference;
	  scanf("%d", &r);
	  pi=3.14;
	  area=pi*r*r;
	  circumference=2*pi*r;
	  printf("area=%d.2f, circumference=%d.2f",area, circumference);
	  return 0;
}	  