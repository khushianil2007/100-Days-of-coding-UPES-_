// WRITE A PROGRAM to input two numbers and display their sum, difference, product and quotie
#include<stdio.h>
int main()
{
    int a,b;
	int sum, sub, mul, div;
	scanf("%d%d",&a,&b);
	sum=a+b;
	sub=a-b;
	mul=a*b;
	div=a/b;
	printf("sum=%d,diff=%d, product=%d, quotient=%d",sum,sub,mul,div);
	return 0;
}

	
	
	